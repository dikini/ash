{
  "name": "ash-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "node scripts/prepare-study.mjs && astro build && pagefind --site dist && node scripts/check-links.mjs",
    "prepare:study": "node scripts/prepare-study.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "test:browser": "playwright test",
    "verify:examples": "node scripts/verify-examples.mjs"
  },
  "dependencies": {
    "astro": "7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "linkedom": "^0.18.12",
    "pagefind": "1.5.2",
    "typescript": "~5.9.3"
  }
}
