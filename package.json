{
  "name": "ash-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "node scripts/prepare-spec.mjs && node scripts/prepare-study.mjs && astro build && node scripts/write-token-manifest.mjs && pagefind --site dist && node scripts/check-links.mjs",
    "prepare:spec": "node scripts/prepare-spec.mjs",
    "prepare:tools": "node scripts/prepare-spec.mjs",
    "prepare:design": "node scripts/prepare-spec.mjs",
    "prepare:study": "node scripts/prepare-study.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "test": "npm run test:tokens && node --test --test-isolation=none tests/*.test.mjs",
    "test:browser": "playwright test",
    "verify:examples": "node scripts/verify-examples.mjs",
    "tokens:sync": "node scripts/sync-design-tokens.mjs",
    "tokens:check": "node scripts/sync-design-tokens.mjs --check",
    "predev": "npm run tokens:sync && npm run prepare:spec",
    "prebuild": "npm run tokens:sync",
    "precheck": "npm run tokens:check",
    "test:tokens": "python3 tests/token_sync_test.py"
  },
  "dependencies": {
    "@sequent-md/core": "file:vendor/sequent-md-core-0.1.0.tgz",
    "@sequent-md/rehype": "file:vendor/sequent-md-rehype-0.1.0.tgz",
    "astro": "7.4.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "rrd-preview": "file:vendor/rrd-preview-0.1.0.tgz",
    "svgdom": "0.1.29",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "linkedom": "^0.18.12",
    "pagefind": "1.5.2",
    "typescript": "~5.9.3"
  }
}
