---
import project from '../data/project';
import '../styles/global.css';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const path = Astro.url.pathname;
const isCurrent = (href: string) => path.startsWith(href) || (href === '/docs/' && Object.values(project.referenceRoutes).some(route => path.startsWith(route)));
const nav = [
  ['Discover', '/discover/'], ['Learn', '/learn/'], ['Docs', '/docs/'],
  ['Status', '/status/'], ['Updates', '/updates/'],
];
const canonical = Astro.site ? new URL(path, Astro.site) : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'Ash' ? 'Ash — Explore the language' : `${title} · Ash`}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f3ec" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=ash-tree" />
    <link rel="preload" href="/fonts/source-sans-3-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/texgyrepagella-regular.otf" as="font" type="font/otf" crossorigin />
    <link rel="stylesheet" href="/theme.css" />
  </head>
  <body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <symbol id="ash-tree" viewBox="0 0 64 64">
        <g fill="currentColor">
          <path d="M28 7C21 12 22 19 28 23C34 19 35 12 28 7Z" />
          <path d="M10 15C20 14 25 20 24 29C15 28 10 23 10 15Z" />
          <path d="M46 15C36 14 31 20 32 29C41 28 46 23 46 15Z" />
          <path d="M8 30C17 28 25 33 25 42C15 43 9 38 8 30Z" />
          <path d="M48 30C39 28 31 33 31 42C41 43 47 38 48 30Z" />
          <path d="M22 53C25 52 26 49 26 45H30C30 49 31 52 34 53Z" />
        </g>
        <path d="M28 49V21M28 33L18 23M28 33L38 23M28 44L16 35M28 44L40 35" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" />
      </symbol>
    </svg>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Ash home"><img class="brand-icon" src="/favicon.svg?v=ash-tree" width="32" height="32" alt="" aria-hidden="true" /><span>ash</span></a>
      <nav class="desktop-nav" aria-label="Main navigation">
        {nav.map(([label, href]) => <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>)}
      </nav>
      <div class="header-tools"><a class="search-link" href="/search/"><svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><span>Search</span></a><a class="source-link" href={project.repository}>Source <img src="/github.svg" width="16" height="16" alt="" aria-hidden="true" /></a></div>
      <details class="mobile-nav"><summary>Menu</summary><nav aria-label="Mobile navigation">{nav.map(([label, href]) => <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>)}<a href="/study/">Study Ash</a><a href="/contribute/">Contribute</a></nav></details>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div><a class="footer-brand" href="/" aria-label="Ash home"><svg class="brand-icon" width="32" height="32" aria-hidden="true"><use href="#ash-tree" /></svg><span>ash</span></a><p>Typed functional programming.<br />Explicit effects and scoped resources.</p></div>
        <div class="footer-links"><a href="/diaries/">Developer diaries</a><a href="/study/">Study Ash</a><a href="/contribute/">Contribute</a><a href={project.repository}>GitHub</a><a href="/status/">Project status</a></div>
        <p class="footer-note">Implementation, documentation,<br />and open language research.</p>
        <svg class="footer-mark" viewBox="0 0 64 64" aria-hidden="true"><use href="#ash-tree" /></svg>
      </div>
    </footer>
  </body>
</html>
