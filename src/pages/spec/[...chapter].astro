---
import Reference from '../../layouts/Reference.astro';
import { loadReferencePublication } from '../../data/reference';
import type { ReferencePage, ReferenceGroup } from '../../data/reference';

export async function getStaticPaths() {
  const publication = await loadReferencePublication();
  return publication.pages.map((page, index) => ({
    params: { chapter: page.route === '/spec/' ? undefined : page.route.slice('/spec/'.length, -1) },
    props: { page, group: publication, revision: publication.revision, index },
  }));
}
interface Props { page: ReferencePage; group: ReferenceGroup; revision: string; index: number; }
---
<Reference {...Astro.props} kind="spec" />
