---
import { getCollection } from 'astro:content';
import Site from '../layouts/Site.astro';
import CodeExample from '../components/CodeExample.astro';
import source from '../../examples/effects.ash?raw';
import project from '../data/project';
const latest = (await getCollection('pages', ({ data }) => data.section === 'Updates' && !data.draft))
  .sort((a, b) => b.data.updated.localeCompare(a.data.updated))[0];
const diaryPreviewLimit = 3;
const recentDiaries = (await getCollection('pages', ({ data }) => data.section === 'Developer Diaries' && !data.draft))
  .sort((a, b) => b.data.published!.localeCompare(a.data.published!) || a.data.route.localeCompare(b.data.route)).slice(0, diaryPreviewLimit);
const formatDate = (date: string) => new Date(`${date}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Site title="Ash" description="A statically typed functional language where types, effects, and resources are declared in the program. Read a complete program, take the tour, and explore the current implementation.">
  <div class="home" data-pagefind-body>
    <div class="intro-line">
      <p>The Ash programming language</p>
      <a class="status-pill" href="/status/"><span aria-hidden="true"></span>In active development</a>
    </div>

    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title"><span>Types declare the shape.</span> <span>Effect rows say what is asked.</span> <span>Resources stay scoped.</span></h1>
        <p class="hero-description">An evolving functional language that pairs expressiveness with assurance. The types are the contract; the code must keep it.</p>
        <div class="hero-actions">
          <a class="button primary" href="/learn/tour/">Take the language tour</a>
          <a class="text-link" href="/docs/install/">Install Ash</a>
        </div>
        <p class="hero-footnote">The command-line tool is currently built from source.</p>
      </div>
      <div class="hero-example">
        <h2 class="example-caption">A request, and its handler</h2>
        <CodeExample source={source} filename="effects.ash" output="42 : Int" />
        <p class="example-explanation"><code>calculate</code> requests a value. The handler supplies <code>40</code>, and the calculation adds <code>2</code>.</p>
        <a class="text-link" href="/learn/tour/#effects-and-handlers">Walk through this program</a>
      </div>
    </section>

    <section class="principles" aria-labelledby="principles-title">
      <div class="section-intro">
        <p class="eyebrow">Discover</p>
        <h2 id="principles-title">Declared,<br />not discovered</h2>
        <p>Data, requests, and resources shape the program.</p>
        <a class="text-link" href="/discover/">Discover the language</a>
      </div>
      <dl class="principle-list">
        <div><dt>Data types</dt><dd><p>Nominal data types define the possible cases. Generics and interfaces carry the expressiveness; local inference saves effort, and the type checker keeps it honest.</p></dd></div>
        <div><dt>Effects and handlers</dt><dd><p>Effect rows describe what a computation can request. Lexical handlers decide how those requests are answered.</p></dd></div>
        <div><dt>Scoped resources</dt><dd><p>Resource checking constrains where access can be used, including access captured by a function.</p></dd></div>
      </dl>
    </section>

    <section class="paths" aria-labelledby="paths-title">
      <div class="section-intro">
        <p class="eyebrow">Learn</p>
        <h2 id="paths-title">Tour, Study, Specs</h2>
        <p>Twenty minutes, a course of study, or the final word — choose your depth.</p>
      </div>
      <div class="path-grid">
        <a class="path-card" href="/learn/tour/">
          <h3>Take the short tour</h3>
          <p>Three complete programs covering functions, data, and effects. Assumes some programming experience.</p>
          <span class="path-cta">Read the tour</span>
        </a>
        <a class="path-card" href="/study/">
          <h3>Study Ash</h3>
          <p>Work through connected lessons and worked cases, beginning with values and functions.</p>
          <span class="path-cta">Open the study guide</span>
        </a>
        <a class="path-card" href={project.referenceRoutes.spec}>
          <h3>Read the specification</h3>
          <p>Look up syntax, type checking, and semantics in the language reference.</p>
          <span class="path-cta">Open the reference</span>
        </a>
      </div>
    </section>

    <section class="honest-status" aria-labelledby="status-title">
      <div class="section-intro">
        <p class="eyebrow">Project status</p>
        <h2 id="status-title">Working implementation.<br />Ongoing research.</h2>
      </div>
      <div>
        <p>Ash has an executable implementation and a language specification. Connecting programs with properties and evidence remains a research goal. Stability and production readiness are not promised.</p>
        <a class="text-link" href="/status/">Read the capabilities and limitations</a>
      </div>
      <svg class="status-mark" viewBox="0 0 64 64" aria-hidden="true"><use href="#ash-tree" /></svg>
    </section>

    <section class="project-notes" aria-label="From the project">
      <div class="diary-invitation">
        <p class="eyebrow">Diaries</p>
        <h2 id="diaries-title">Developer diaries</h2>
        {recentDiaries.length ? recentDiaries.map(({ data }) => <div class="diary-preview">
          <a class="update-preview" href={`/${data.route}/`}>
            <time datetime={data.published}>{formatDate(data.published!)}</time>
            <h3>{data.title}</h3>
            <p>{data.description}</p>
          </a>
          <p>By {data.author_uri ? <a href={data.author_uri} rel="author">{data.author}</a> : data.author}</p>
        </div>) : <p>Experiments, implementation questions, and work in progress between milestones.</p>}
        <a class="text-link" href="/diaries/">Read developer diaries</a>
      </div>
      <div class="latest-update">
        <p class="eyebrow">Updates</p>
        <h2>Latest update</h2>
        {latest ? <a class="update-preview" href={`/${latest.data.route}/`}>
          <time datetime={latest.data.updated}>{formatDate(latest.data.updated)}</time>
          <h3>{latest.data.title}</h3>
          <p>{latest.data.description}</p>
        </a> : <p>No updates published yet.</p>}
        <a class="text-link" href="/updates/">All updates</a>
      </div>
    </section>
  </div>
</Site>
