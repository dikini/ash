---
import { readFile } from 'node:fs/promises';
import Site from '../../layouts/Site.astro';
import '../../styles/spec.css';
import { styles as sequentStyles } from '@sequent-md/core';

interface Chapter {
  file: string; route: string; title: string; titleId: string; html: string;
  headings: { depth: number; slug: string; text: string }[];
}
interface Publication { revision: string; directory: string; pages: Chapter[]; }
export async function getStaticPaths() {
  let publication: Publication;
  try { publication = JSON.parse(await readFile(new URL('../../../.cache/ash-spec/publication.json', import.meta.url), 'utf8')); }
  catch (cause) { throw new Error('Prepare specifications with npm run prepare:spec before running Astro.', { cause }); }
  return publication.pages.map((page, index) => ({
    params: { chapter: page.route === '/spec/' ? undefined : page.route.slice('/spec/'.length, -1) },
    props: { page, publication, index },
  }));
}
interface Props { page: Chapter; publication: Publication; index: number; }
const { page, publication, index } = Astro.props;
const sourceUrl = `https://github.com/dikini/ash-lang/blob/${publication.revision}/${publication.directory}/${page.file}`;
const previous = publication.pages[index - 1];
const next = publication.pages[index + 1];
const description = `${page.title} from the canonical Ash language specification.`;
const chapterTitle = (chapter: Chapter) => chapter.file === 'README.md' ? 'Overview' : chapter.title;
---
<Site title={page.title} description={description}>
  <style is:inline set:html={sequentStyles} />
  <div class="article-shell spec-reading">
    <header class="article-heading">
      <p class="eyebrow"><a href="/docs/">Documentation</a> / Specification</p>
      <h1 id={page.titleId} data-pagefind-meta="title">{page.title}</h1>
      <p class="spec-source">Development specification · <a href={sourceUrl}>ash-lang <code>{publication.revision.slice(0, 7)}</code></a></p>
    </header>
    <nav class="spec-chapters" aria-label="Specification chapters">
      {publication.pages.map(chapter => <a href={chapter.route} aria-current={chapter.route === page.route ? 'page' : undefined}>{chapterTitle(chapter)}</a>)}
    </nav>
    <div class="article-grid">
      <article class="prose spec-prose" data-pagefind-body set:html={page.html} />
      <aside class="article-aside">
        {page.headings.some(heading => heading.depth === 2) && <nav aria-label="On this page">
          <p class="eyebrow">On this page</p>
          {page.headings.filter(heading => heading.depth === 2).map(heading => <a href={`#${heading.slug}`}>{heading.text}</a>)}
        </nav>}
        <div class="aside-note"><p>These rules describe the source revision linked above.</p><a href="/docs/install/">Build the website’s example checkpoint ↗</a></div>
      </aside>
    </div>
    <nav class="spec-pagination" aria-label="Adjacent specification chapters">
      {previous ? <a rel="prev" href={previous.route}>← {chapterTitle(previous)}</a> : <span />}
      {next && <a rel="next" href={next.route}>{chapterTitle(next)} →</a>}
    </nav>
  </div>
</Site>
