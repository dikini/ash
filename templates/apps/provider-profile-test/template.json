    {
      "name": "app_name",
      "required": true,
      "default": null
    }
  ],
  "files": [
    {
      "path": "src/main.ash",
      "content": "use runtime::RuntimeError;\nuse test::{deterministic_profile_fixture, provider_evidence_summary};\n\nfn main() -> Result<(), RuntimeError> { Ok { value: {} } }\n"
    }
  ],
  "generated_checks": [
    {
      "command": "ash check src/main.ash",
      "file": "src/main.ash"
    }
  ]
}
