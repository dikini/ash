---
interface Props { source: string; filename: string; output?: string; }
const { source, filename, output } = Astro.props;
---
<figure class="code-example">
  <figcaption><span>{filename}</span><span class="code-language">Ash</span></figcaption>
  <pre tabindex="0" aria-label={`Source code: ${filename}`}><code>{source.trimEnd()}</code></pre>
  {output && <div class="code-result"><span class="result-label">Result</span><samp>{output}</samp></div>}
</figure>
