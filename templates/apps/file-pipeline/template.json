{
  "schema_version": "ash-template-v1",
  "id": "file-pipeline",
  "version": "0.1.0",
  "description": "Current-syntax file pipeline skeleton",
  "required_profiles": ["read-write-filesystem"],
  "providers": [
    {
      "profile": "read-write-filesystem",
      "provider": "filesystem",
      "operations": ["read_to_string", "write_string"]
    }
  ],
  "resources": ["workspace-files"],
  "evidence_expectations": ["ash check src/main.ash", "filesystem evidence is redacted"],
  "parameters": [
    {
      "name": "app_name",
      "required": true,
      "default": null
    }
  ],
  "files": [
    {
      "path": "src/main.ash",
      "content": "use runtime::RuntimeError;\nuse test::{assert_true};\n\nfn main() -> Result<(), RuntimeError> { Ok { value: {} } }\n"
    }
  ],
  "generated_checks": [
    {
      "command": "ash check src/main.ash",
      "file": "src/main.ash"
    }
  ]
}
