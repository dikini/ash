---
import '../styles/global.css';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const path = Astro.url.pathname;
const isCurrent = (href: string) => path.startsWith(href) || (href === '/docs/' && path.startsWith('/spec/'));
const nav = [
  ['Discover', '/discover/'], ['Learn', '/learn/'], ['Docs', '/docs/'],
  ['Status', '/status/'], ['Updates', '/updates/'],
];
const canonical = Astro.site ? new URL(path, Astro.site) : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'Ash' ? 'Ash — Explore the language' : `${title} · Ash`}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f3ec" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=ash-tree" />
    <link rel="preload" href="/fonts/source-sans-3-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/theme.css" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Ash home"><img class="brand-icon" src="/favicon.svg?v=ash-tree" width="32" height="32" alt="" aria-hidden="true" /><span>ash<span class="brand-dot">·</span></span></a>
      <nav class="desktop-nav" aria-label="Main navigation">
        {nav.map(([label, href]) => <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>)}
      </nav>
      <div class="header-tools"><a class="search-link" href="/search/"><svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><span>Search</span></a><a class="source-link" href="https://github.com/dikini/ash-lang">Source <img src="/github.svg" width="16" height="16" alt="" aria-hidden="true" /></a></div>
      <details class="mobile-nav"><summary>Menu</summary><nav aria-label="Mobile navigation">{nav.map(([label, href]) => <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>)}<a href="/study/">Study Ash</a><a href="/contribute/">Contribute</a></nav></details>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div><a class="footer-brand" href="/" aria-label="Ash home"><img class="brand-icon" src="/favicon.svg?v=ash-tree" width="32" height="32" alt="" aria-hidden="true" /><span>ash<span class="brand-dot">·</span></span></a><p>A language taking shape.<br />Explore it. Question it. Help build it.</p></div>
      <div class="footer-links"><a href="/diaries/">Developer diaries</a><a href="/study/">Study Ash</a><a href="/contribute/">Contribute</a><a href="https://github.com/dikini/ash-lang">GitHub ↗</a><a href="/status/">Project status</a></div>
      <p class="footer-note">An evolving language.<br />Capabilities and limits, stated openly.</p>
    </footer>
  </body>
</html>
